{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://n2n.redhat.com/schemas/n2n.room.v1/rpc.schema.json",
  "title": "ThoughtKhoral room v1 JSON-RPC request",
  "type": "object",
  "properties": {
    "jsonrpc": { "const": "2.0" },
    "id": { "type": "string", "minLength": 1 },
    "method": {
      "enum": [
        "session.authenticate",
        "room.join",
        "chat.send",
        "decision.propose",
        "decision.transition",
        "decision.delete"
      ]
    },
    "params": { "type": "object" }
  },
  "$defs": {
    "mention": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "participant" },
            "id": { "type": "string", "format": "uuid" },
            "token": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
          },
          "required": ["type", "id", "token"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "alias" },
            "alias": { "enum": ["allhumans", "allagents"] }
          },
          "required": ["type", "alias"],
          "additionalProperties": false
        }
      ]
    },
    "mentions": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/mention" }
    },
    "delivery": { "enum": ["room", "mentioned"] }
  },
  "required": ["jsonrpc", "id", "method", "params"],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "method": { "const": "session.authenticate" },
        "params": {
          "type": "object",
          "properties": {
            "accessToken": { "type": "string", "minLength": 1 }
          },
          "required": ["accessToken"],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "method": { "const": "room.join" },
        "params": {
          "type": "object",
          "allOf": [
            { "$ref": "https://n2n.redhat.com/schemas/n2n.room.v1/envelope.schema.json" }
          ],
          "properties": {
            "afterSequence": { "type": "integer", "minimum": 0 }
          },
          "unevaluatedProperties": false
        }
      }
    },
    {
      "properties": {
        "method": { "const": "chat.send" },
        "params": {
          "type": "object",
          "allOf": [
            { "$ref": "https://n2n.redhat.com/schemas/n2n.room.v1/envelope.schema.json" },
            {
              "if": {
                "properties": { "delivery": { "const": "mentioned" } },
                "required": ["delivery"]
              },
              "then": {
                "required": ["mentions"],
                "properties": {
                  "mentions": { "type": "array", "minItems": 1 }
                }
              }
            }
          ],
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "mentions": { "$ref": "#/$defs/mentions" },
            "delivery": { "$ref": "#/$defs/delivery" }
          },
          "required": ["text"],
          "unevaluatedProperties": false
        }
      }
    },
    {
      "properties": {
        "method": { "const": "decision.propose" },
        "params": {
          "type": "object",
          "allOf": [
            { "$ref": "https://n2n.redhat.com/schemas/n2n.room.v1/envelope.schema.json" }
          ],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "summary": { "type": "string", "minLength": 1 },
            "sourceEventIds": {
              "type": "array",
              "minItems": 0,
              "items": { "type": "string", "format": "uuid" }
            }
          },
          "required": ["title", "summary", "sourceEventIds"],
          "unevaluatedProperties": false
        }
      }
    },
    {
      "properties": {
        "method": { "const": "decision.transition" },
        "params": {
          "type": "object",
          "allOf": [
            { "$ref": "https://n2n.redhat.com/schemas/n2n.room.v1/envelope.schema.json" }
          ],
          "properties": {
            "decisionId": { "type": "string", "format": "uuid" },
            "action": { "enum": ["confirm", "edit", "dismiss"] },
            "editedTitle": { "type": "string", "minLength": 1 },
            "editedSummary": { "type": "string", "minLength": 1 }
          },
          "required": ["decisionId", "action"],
          "if": { "properties": { "action": { "const": "edit" } } },
          "then": {
            "properties": {
              "editedTitle": true,
              "editedSummary": true
            },
            "required": ["editedTitle", "editedSummary"]
          },
          "else": {
            "not": {
              "anyOf": [
                { "properties": { "editedTitle": true }, "required": ["editedTitle"] },
                { "properties": { "editedSummary": true }, "required": ["editedSummary"] }
              ]
            }
          },
          "unevaluatedProperties": false
        }
      }
    },
    {
      "properties": {
        "method": { "const": "decision.delete" },
        "params": {
          "type": "object",
          "allOf": [
            { "$ref": "https://n2n.redhat.com/schemas/n2n.room.v1/envelope.schema.json" }
          ],
          "properties": {
            "decisionId": { "type": "string", "format": "uuid" }
          },
          "required": ["decisionId"],
          "unevaluatedProperties": false
        }
      }
    }
  ]
}
