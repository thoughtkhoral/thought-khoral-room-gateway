{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thoughtkhoral/thought-khoral-contracts/schemas/agent-conversation-v1/view.schema.json",
  "title": "ThoughtKhoral agent conversation v1 view",
  "type": "object",
  "properties": {
    "profileVersion": {
      "const": "thought-khoral.agent-conversation.v1"
    },
    "roomId": {
      "type": "string",
      "minLength": 1,
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "agentId": {
      "type": "string",
      "minLength": 1,
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "conversation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "state": {
              "enum": [
                "reserved",
                "running",
                "ready",
                "unusable"
              ]
            },
            "activeTaskId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "format": "uuid",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "consumedRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "policyRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "guidanceRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "selectedSettings": {
              "anyOf": [
                {
                  "$ref": "turn.schema.json#/$defs/selectedSettings"
                },
                {
                  "type": "null"
                }
              ]
            },
            "effectiveSettings": {
              "anyOf": [
                {
                  "$ref": "turn.schema.json#/$defs/effectiveSettings"
                },
                {
                  "type": "null"
                }
              ]
            },
            "usage": {
              "anyOf": [
                {
                  "$ref": "turn.schema.json#/$defs/usage"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "generation",
            "state",
            "activeTaskId",
            "consumedRevision",
            "policyRevision",
            "guidanceRevision",
            "selectedSettings",
            "effectiveSettings",
            "usage"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "profileVersion",
    "roomId",
    "agentId",
    "conversation"
  ],
  "additionalProperties": false
}
